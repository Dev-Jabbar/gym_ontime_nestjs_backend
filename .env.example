# Gym Ontime backend — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Auth ---
# Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Frontend ---
# Paystack redirects to ${FRONTEND_URL}/payment-success after checkout.
# The frontend runs on port 4000 locally (yarn dev). Restart after changing this.
FRONTEND_URL=http://localhost:4000

# --- Paystack ---
PAYSTACK_SECRET_KEY=your-paystack-test-secret-key

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Redis (cache + queue) ---
# If unset, the queue module is not loaded and the cache is skipped.
REDIS_URL=redis://localhost:6379
# Redis DB used by the queue (the cache uses DB 0). Defaults to 1.
QUEUE_REDIS_DB=1

# --- Maintenance sweep (leave unset except when testing locally) ---
# MAINTENANCE_INTERVAL_MINUTES=15
# PAYMENT_STALE_MINUTES=30
# How often the subscription-expiry job runs, in minutes. Defaults to 60.
# SUBSCRIPTION_EXPIRY_INTERVAL_MINUTES=60
# Class reminders: how often the job runs, and how far ahead a class is reminded (minutes).
# CLASS_REMINDER_INTERVAL_MINUTES=15
# CLASS_REMINDER_WINDOW_MINUTES=60

# --- Admin seed (ADMIN_PASSWORD required when NODE_ENV=production) ---
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=admin
# ADMIN_AVATAR=/avatar.jpg
# ADMIN_PASSWORD=change-me

# --- Firebase push notifications (optional; push is disabled if unset) ---
# From Firebase console > Project settings > Service accounts > Generate new private key.
# Keep the private key on ONE line with \n for line breaks. Quotes are fine in this
# .env file; on Render, Kubernetes (.env.k8s) and other hosts paste it WITHOUT quotes.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account-email
# FIREBASE_PRIVATE_KEY="your-private-key"

# --- OpenTelemetry tracing (optional; off unless OTEL_ENABLED=true) ---
# Start Jaeger first: docker compose up -d redis jaeger   (UI: http://localhost:16686)
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=gym-ontime-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Production security (all optional) ---
# NODE_ENV=production makes the login cookie SameSite=None + Secure (needed
# when the frontend and API are on different domains, e.g. Vercel + Render).
# NODE_ENV=production
# Override the cookie mode: true = SameSite=None+Secure, false = Lax.
# COOKIE_CROSS_SITE=true
# Number of proxies in front of the app (Render/Railway/Fly = 1). Default 1
# in production, 0 locally. Needed so the login rate limit sees real client IPs.
# TRUST_PROXY_HOPS=1
# Turns off the login/register rate limit (testing only, never in production).
# THROTTLE_DISABLED=true

# --- CORS (optional) ---
# Comma-separated browser origins allowed to call the API. When unset, the
# built-in list (localhost:3000/4000 + the Vercel site) is used. FRONTEND_URL
# is always allowed as well.
# CORS_ORIGINS=https://gym-ontime.vercel.app,https://www.example.com

# --- Tests only ---
# A LOCAL or CI Postgres for the real-database seat tests. Without it those tests
# are skipped. The tests refuse any host except localhost / 127.0.0.1 / ::1 / postgres.
# TEST_DATABASE_URL=postgresql://ci:ci@localhost:5433/gym_ontime_test
