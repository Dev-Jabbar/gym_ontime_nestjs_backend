# Gym Ontime backend — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Auth ---
# Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Frontend ---
# Paystack redirects to ${FRONTEND_URL}/payment-success after checkout.
FRONTEND_URL=http://localhost:3000

# --- Paystack ---
PAYSTACK_SECRET_KEY=your-paystack-test-secret-key

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Redis (cache + queue) ---
# If unset, the queue module is not loaded and the cache is skipped.
REDIS_URL=redis://localhost:6379
# Redis DB used by the queue (the cache uses DB 0). Defaults to 1.
QUEUE_REDIS_DB=1

# --- Maintenance sweep (leave unset except when testing locally) ---
# MAINTENANCE_INTERVAL_MINUTES=15
# PAYMENT_STALE_MINUTES=30
# How often the subscription-expiry job runs, in minutes. Defaults to 60.
# SUBSCRIPTION_EXPIRY_INTERVAL_MINUTES=60

# --- Admin seed (ADMIN_PASSWORD required when NODE_ENV=production) ---
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=admin
# ADMIN_AVATAR=/avatar.jpg
# ADMIN_PASSWORD=change-me